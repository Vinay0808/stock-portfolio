# Client environment variables (will be picked up by CRA when prefixed with REACT_APP_)
# API base URL for the backend. In development the default is localhost:5000.
REACT_APP_API_URL=http://localhost:5000

# For production deployments (Netlify), set this to your Render service endpoint:
# REACT_APP_API_URL=https://your-backend-service.onrender.com
