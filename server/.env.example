# Server environment variables (copy to .env in development)
# Port on which the express server will run
PORT=5000

# MongoDB connection string. For local development you can use the fallback value hardcoded in server.js
# Example for Atlas (replace <user>,<pass>,<cluster> accordingly):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/stockPortfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/stockPortfolio

# URL of the frontend application (used for CORS)
# Locally you can leave as http://localhost:3000
# In production set to your Netlify URL e.g. https://your-app.netlify.app
FRONTEND_URL=http://localhost:3000
